# Replace example.com and certificate paths after domain ownership and TLS verification.
server {
 listen 80;
 server_name example.com;
 root /var/www/html;
 location /.well-known/acme-challenge/ { try_files $uri =404; }
 location / { return 301 https://$host$request_uri; }
}
server {
 listen 443 ssl;
 server_name example.com;
 ssl_certificate /etc/letsencrypt/live/example.com/fullchain.pem;
 ssl_certificate_key /etc/letsencrypt/live/example.com/privkey.pem;
 ssl_protocols TLSv1.2 TLSv1.3;
 root /opt/recitewords-web/current/site;
 index index.html;
 include /etc/nginx/mime.types;
 types { application/javascript mjs; }
 gzip on;
 gzip_types application/json application/javascript text/css;
 gzip_min_length 1024;
 client_max_body_size 3m;
 location /auth/v1/ { proxy_pass http://127.0.0.1:18000; proxy_set_header X-Forwarded-For $remote_addr; proxy_set_header X-Forwarded-Proto https; }
 location /rest/v1/ { proxy_pass http://127.0.0.1:18000; proxy_set_header X-Forwarded-For $remote_addr; }
 location /functions/v1/ { proxy_pass http://127.0.0.1:18000; proxy_read_timeout 65s; proxy_set_header X-Forwarded-For $remote_addr; }
 location / { try_files $uri $uri/ =404; }
 location ~* \.(html|mjs|js|css)$ {
  add_header Cache-Control "no-cache" always;
  try_files $uri =404;
 }
 location ~ /\. { deny all; }
 add_header X-Content-Type-Options nosniff always;
 add_header Referrer-Policy strict-origin-when-cross-origin always;
 add_header Permissions-Policy "microphone=(self)" always;
 # API gateway binds to loopback only. Do not expose Postgres or Studio ports.
}
