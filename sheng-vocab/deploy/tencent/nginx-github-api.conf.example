# Tested GitHub-to-Tencent API proxy. Replace host/certificate and allowed frontend origin together for domain migration.
map $http_origin $rw_test_origin {
 default "";
 "https://6v8nhmyrfj-art.github.io" $http_origin;
}
server {
 listen 80 default_server;
 server_name 129.204.40.183;
 root /var/www/html;
 location /.well-known/acme-challenge/ { try_files $uri =404; }
 location / { return 301 https://129.204.40.183$request_uri; }
}
server {
 listen 443 ssl default_server;
 server_name 129.204.40.183;
 ssl_certificate /etc/letsencrypt/live/129.204.40.183/fullchain.pem;
 ssl_certificate_key /etc/letsencrypt/live/129.204.40.183/privkey.pem;
 ssl_protocols TLSv1.2 TLSv1.3;
 client_max_body_size 3m;
 location ~ ^/(auth|rest|functions)/v1/ {
  proxy_hide_header Access-Control-Allow-Origin;
  proxy_hide_header Access-Control-Allow-Headers;
  proxy_hide_header Access-Control-Allow-Methods;
  add_header Access-Control-Allow-Origin $rw_test_origin always;
  add_header Access-Control-Allow-Headers "authorization,apikey,content-type,x-client-info" always;
  add_header Access-Control-Allow-Methods "GET,POST,PUT,PATCH,DELETE,OPTIONS" always;
  add_header Vary Origin always;
  if ($request_method = OPTIONS) { return 204; }
  proxy_pass http://127.0.0.1:18000;
  proxy_set_header Host $host;
  proxy_set_header X-Forwarded-Proto https;
  proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
  proxy_read_timeout 65s;
 }
 location / { return 404; }
}
